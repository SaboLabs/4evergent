# 4evergent environment configuration
#
# SECURITY: Never put private keys or seeds in this file, in source code,
# in logs, or in tests. Signing keys are loaded from a secrets manager or
# KMS at runtime only.

# Stellar network (MVP is testnet-first)
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_PASSPHRASE=Test SDF Network ; September 2015

# Server
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info
